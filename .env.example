# Скопируйте в .env. Реальные секреты храните только в .env.

# Настройки Core API используют префикс CORE_API_.
# Исключения: DATABASE_URL и REDIS_URL — без префикса.
# Переменные окружения имеют приоритет над значениями из .env.
CORE_API_LOG_LEVEL=INFO

# Telegram: пустой токен включает режим логирования уведомлений.
TELEGRAM_BOT_TOKEN=

# Ключ для POST /debug/event, заголовок X-Admin-Key.
# Пустое значение выключает эндпоинт.
ADMIN_KEY=

# Подключения для локального запуска Core API.
# PostgreSQL и Redis запущены в Docker с опубликованными портами.
# Для Core API обязателен драйвер postgresql+asyncpg.
DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:5432/realestate
REDIS_URL=redis://localhost:6379/0
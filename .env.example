# Скопируйте в .env. Реальные секреты храните только в .env.

# Учётные данные PostgreSQL для docker compose.
# Меняются только вместе с volume: существующий контейнер
# создаёт пользователя/пароль один раз при первом старте.
# В пароле допустимы любые знаки (@, :, / и др.) — сервисы
# собирают адрес подключения сами и экранируют спецсимволы.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=realestate

# Порт PostgreSQL на хосте. Поднимите на 5433, если локальный
# Postgres уже занимает 5432 (внутри docker-сети всегда 5432).
POSTGRES_PORT=5432

# Настройки Core API используют префикс CORE_API_.
# Исключения: DATABASE_URL, POSTGRES_* и REDIS_URL — без префикса.
# Переменные окружения имеют приоритет над значениями из .env.
CORE_API_LOG_LEVEL=INFO

# Telegram: пустой токен включает режим логирования уведомлений.
TELEGRAM_BOT_TOKEN=

# Ключ для POST /debug/event, заголовок X-Admin-Key.
# Пустое значение выключает эндпоинт.
ADMIN_KEY=

# Подключения для локального запуска Core API (без docker compose).
# PostgreSQL и Redis запущены в Docker с опубликованными портами.
# Для Core API обязателен драйвер postgresql+asyncpg.
DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:5432/realestate
REDIS_URL=redis://localhost:6379/0
# Скопируйте в .env и заполните значения: cp .env.example .env
# Секреты хранятся только в .env (НФТ-1), файл .env в git не попадает.

# Токен Telegram-бота от @BotFather.
# Пусто — notifier работает в режиме «лог»: совпадения пишутся в stdout (ФТ-3.6).
TELEGRAM_BOT_TOKEN=

# Ключ служебного эндпоинта POST /debug/event (заголовок X-Admin-Key, НФТ-3).
# Пусто — эндпоинт выключен (отвечает 404).
ADMIN_KEY=

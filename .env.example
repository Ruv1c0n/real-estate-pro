# Скопируйте в .env. Реальные секреты храните только в .env.

# Учётные данные PostgreSQL для docker compose, общие для core-api и notifier.
# Меняются только вместе с volume: существующий контейнер
# создаёт пользователя/пароль один раз при первом старте.
# В пароле допустимы любые знаки (@, :, / и др.) — сервисы
# собирают адрес подключения сами и экранируют спецсимволы.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=realestate

# Порт PostgreSQL на хосте. Поднимите на 5433, если локальный
# Postgres уже занимает 5432 (внутри docker-сети всегда 5432).
POSTGRES_PORT=5432

# TLS для подключений notifier к PostgreSQL (sslmode в собранном DSN).
# По умолчанию disable — для учебного стенда внутри docker-сети этого
# достаточно; при выносе PostgreSQL наружу укажите требуемый режим
# (например require).
# POSTGRES_SSLMODE=disable

# Настройки Core API используют префикс CORE_API_.
# Исключения: DATABASE_URL, POSTGRES_* и REDIS_URL — без префикса.
# Переменные окружения имеют приоритет над значениями из .env.
CORE_API_LOG_LEVEL=INFO

# Per-service роли БД (миграция 0002_roles_per_service, PR #82). Пары
# user/password обязательны both-or-neither: неполная пара валит стек на
# старте с явной ошибкой. Пароли живут только здесь; роли создаются
# миграцией LOGIN без пароля, разовая выдача — сервис db-roles-setup
# (ALTER ROLE через psql -v, без литералов в команде). Внимание: пока
# alembic-миграции не включены в compose-стартап, пары задавать рано —
# сначала alembic upgrade head. Пустые значения — прежний режим: оба
# сервиса под общей ролью app.
# CORE_API_DB_USER=core_api
# CORE_API_DB_PASSWORD=
# NOTIFIER_DB_USER=notifier
# NOTIFIER_DB_PASSWORD=

# Telegram: пустой токен включает режим логирования уведомлений.
TELEGRAM_BOT_TOKEN=

# Ключ для POST /debug/event, заголовок X-Admin-Key.
# Пустое значение выключает эндпоинт.
ADMIN_KEY=

# Подключения для локального запуска Core API (без docker compose).
# PostgreSQL и Redis запущены в Docker с опубликованными портами.
# Для Core API обязателен драйвер postgresql+asyncpg.
DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:5432/realestate
REDIS_URL=redis://localhost:6379/0
# Скрипты бэкапа PostgreSQL (scripts/db/backup.sh, ТЗ 6.1). Значения по
# умолчанию совпадают с POSTGRES_* выше; переопределять нужно только для
# источника вне compose (PG_MODE=host) — см. docs/db-backup-restore.md.
# PG_MODE=compose
# PG_HOST=host.docker.internal
# PG_PORT=5432
# PG_USER=app
# PG_PASSWORD=app
# PG_DB=realestate

# .gitattributes
# Единые концы строк: в репозитории всегда LF, git сам конвертирует под ОС.
# Гарантирует, что локальный 'gofmt -l' на Windows не видит CRLF-шум
# (проблема из PR #21: файлы без финального перевода строки прошли мимо внимания).
* text=auto

# Явно фиксируем LF для кода и конфигов
*.go    text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf

# Windows-скрипты остаются CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Бинарные файлы — без какой-либо конвертации
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
